{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/blog-automation-run",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/fisiomais",
      "destination": "https://fisiomais-iota.vercel.app/"
    },
    {
      "source": "/fisiomais/:path*",
      "destination": "https://fisiomais-iota.vercel.app/:path*"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/((?!api/|og-image-).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/blog/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
